root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts,gradle,properties,toml,xml,yaml,yml,json,md}]
indent_size = 4

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf

[*.ps1]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,webp,ico,jar}]
charset = unset
end_of_line = unset
insert_final_newline = unset
